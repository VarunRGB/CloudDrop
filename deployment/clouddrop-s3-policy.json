{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBucketVersioningAndListVersions",
      "Effect": "Allow",
      "Action": ["s3:GetBucketVersioning", "s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::CloudDropS3UserObjectsPolicy"
    },
    {
      "Sid": "ManageOnlyCloudDropUserObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::CloudDropS3UserObjectsPolicy/users/*"
    }
  ]
}
