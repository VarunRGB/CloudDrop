[Unit]
Description=CloudDrop FastAPI application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/CloudDrop/backend
EnvironmentFile=/etc/clouddrop.env
ExecStart=/opt/CloudDrop/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
